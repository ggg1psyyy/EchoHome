# EchoHome setup tool — environment variables
# Copy to .env and fill in values before starting
# ── Network ───────────────────────────────────────────────────────────────────
# Bind address — 0.0.0.0 to listen on all interfaces
SERVER_HOST=0.0.0.0
# WebSocket server port — devices connect here (/control, /data, /shell)
SERVER_PORT=8767
# Device-link TLS (wss) port — same three WS planes wrapped in TLS with a
# controller-generated private CA (persisted next to the database, tls/
# subdirectory). Devices holding pushed credentials connect here instead.
# Advertised to devices via mDNS (tls_port). The port is meant to move, not
# to be switched off: a device holding a CA will not fall back to plain, so
# 0 would strand every credentialed Echo until each is re-paired by hand.
SERVER_TLS_PORT=8770
# Enforcing posture: 1 rejects any device connection that is not TLS with a
# valid per-device token. Leave 0 until every device shows "wss (TLS)" in
# the dashboard — plain connections are the pre-TLS default and the
# credential push itself needs a working (plain) shell plane.
REQUIRE_DEVICE_TLS=0
# HTTP API + dashboard port
API_PORT=8768
# IP address of this host on the LAN — advertised via mDNS
# Devices use this to connect; must be reachable from Echo Dots.
# Leave empty or unset to detect it from the routing table; the controller
# refuses to start rather than advertise an address it had to guess at.
SERVER_IP=10.x.y.z
# mDNS service name — advertised as {MDNS_NAME}._emcontroller._tcp.local
MDNS_NAME=echomuse
# ── Database ──────────────────────────────────────────────────────────────────
# Path to SQLite database file inside the container
# Mount ~/EchoMuse/controller/data:/app/data in docker-compose.yml
DB_PATH=/app/data/echomuse.db
# ── Device approval ───────────────────────────────────────────────────────────
# strict — unknown devices held in pending queue until admin approves (default)
# auto   — unknown devices approved immediately as "Unknown {serial[:8]}"
DEVICE_APPROVAL=strict
# ── Logging ───────────────────────────────────────────────────────────────────
# 1 raises the controller to DEBUG: the device control plane, the Voice
# Incubator records and the update steps in detail. Verbose enough to be a
# diagnostic setting rather than a default. Read once at startup, so a change
# needs a restart.
DEBUG=0
# Per-logger levels, on top of DEBUG: comma-separated name=LEVEL pairs.
#
#   LOG_LEVELS="echomuse.incubator=DEBUG,aiohttp.access=INFO"
#
# Names follow the logger hierarchy, so `echomuse=DEBUG` covers every
# controller area (echomuse.db, echomuse.incubator, echomuse.firmware …) and a
# name like `aiohttp.access` reaches a third-party logger that no echomuse
# level ever could. Each pair is read as written, so a name can be quieter
# than DEBUG set it — `echomuse.db=WARNING` quiets the database logger with
# DEBUG=0 — and a name here wins over DEBUG for that logger. Read once at
# startup, so a change needs a restart. A pair that is not name=LEVEL, names
# something that is not a logger, or carries an unknown level is reported in
# the log and skipped rather than refused.
LOG_LEVELS=

# Path to a PEM CA certificate to trust, for a single sign-on provider (below)
# served over HTTPS with your own internal certificate authority. Installed
# into the container's system trust store at startup. Mount the certificate
# into the container and give the path inside it.
#
#   volumes:
#     - /path/to/internal-ca.crt:/certs/internal-ca.crt:ro
#   environment:
#     - EM_EXTRA_CA_CERT=/certs/internal-ca.crt
#
# Startup FAILS if the file is missing or is not PEM.
EM_EXTRA_CA_CERT=

# ── Single sign-on (OpenID Connect) ───────────────────────────────────────────
# Sign in through Authentik, Keycloak, Authelia or any OpenID Connect provider.
# Leave OIDC_ISSUER empty to keep password sign-in only. Roles follow group
# membership at the provider, and someone in none of the listed groups cannot
# sign in. See docs/configuration.md → Single sign-on.
OIDC_ISSUER=
# OIDC_CLIENT_ID=echomuse
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://echomuse.example.com/api/auth/oidc/callback
# OIDC_ADMIN_GROUPS=Admins
# OIDC_READONLY_GROUPS=Family
# OIDC_GROUPS_CLAIM=groups
# OIDC_PASSWORD_LOGIN=true
# OIDC_SESSION_HOURS=12
# OIDC_BUTTON_LABEL=Sign in with SSO
